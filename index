
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#6f9259">
<title>NEGEV Lab Concentration Converter</title>

<style>
:root {
  --bg: #edf4f2;
  --card: #ffffff;
  --text: #172033;
  --muted: #667085;
  --line: #d5e2dc;
  --green: #6f9259;
  --blue: #6f97a6;
  --brown: #a87940;
  --shadow: 0 18px 45px rgba(15, 23, 42, 0.14);
  --radius: 24px;
}

* {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

html {
  font-size: 16px;
}

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  background:
    radial-gradient(circle at top left, rgba(111,146,89,0.22), transparent 360px),
    radial-gradient(circle at bottom right, rgba(111,151,166,0.18), transparent 420px),
    var(--bg);
  color: var(--text);
}

.wrapper {
  width: min(100% - 28px, 1040px);
  margin: auto;
  padding: 24px 0 42px;
}

.app {
  background: rgba(255,255,255,0.97);
  border: 1px solid var(--line);
  border-radius: 28px;
  box-shadow: var(--shadow);
  overflow: hidden;
}

.header {
  text-align: center;
  padding: 26px 20px 16px;
  border-bottom: 1px solid var(--line);
  background: linear-gradient(135deg, rgba(111,146,89,0.12), rgba(111,151,166,0.10));
}

.logo {
  width: clamp(170px, 32vw, 310px);
  max-height: 235px;
  object-fit: contain;
  display: block;
  margin: 0 auto 10px;
}

h1 {
  margin: 6px 0 4px;
  color: #17324a;
  font-size: clamp(1.6rem, 4vw, 2.55rem);
  line-height: 1.08;
}

.subtitle {
  margin: 0 auto;
  color: var(--muted);
  font-size: clamp(.92rem, 2vw, 1rem);
  line-height: 1.45;
  max-width: 720px;
}

.main {
  padding: clamp(14px, 2.8vw, 24px);
}

.formula-card {
  max-width: 820px;
  margin: 0 auto 20px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: #f8fbfa;
  padding: clamp(14px, 2.5vw, 22px);
}

label {
  display: block;
  font-weight: 800;
  margin-bottom: 8px;
  color: #27364a;
}

#formula {
  width: 100%;
  text-align: center;
  font-size: clamp(1.7rem, 7vw, 2.8rem);
  font-weight: 900;
  letter-spacing: 0.02em;
  padding: clamp(14px, 3vw, 20px);
  border-radius: 18px;
  border: 2px solid #cbd8d2;
  color: #0f172a;
  outline: none;
  min-height: 64px;
}

#formula:focus {
  border-color: var(--green);
  box-shadow: 0 0 0 4px rgba(111,146,89,0.16);
}

.quick-title {
  text-align: center;
  font-weight: 900;
  margin: 18px 0 10px;
  color: #27364a;
}

.quick-select {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(74px, 1fr));
  gap: 9px;
  margin-bottom: 16px;
}

.quick-select button {
  background: #fff;
  color: #172033;
  border: 1px solid #cfd8d3;
  padding: 11px 10px;
  border-radius: 999px;
  cursor: pointer;
  font-weight: 900;
  font-size: .95rem;
  min-height: 44px;
  box-shadow: 0 2px 7px rgba(15,23,42,0.05);
  white-space: nowrap;
}

.quick-select button:hover {
  background: var(--green);
  color: white;
  border-color: var(--green);
}

.quick-select button:active {
  transform: scale(.98);
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}

.info {
  text-align: center;
  padding: 12px;
  border: 1px solid var(--line);
  border-radius: 16px;
  background: white;
  min-width: 0;
}

.info .key {
  color: var(--muted);
  font-size: .74rem;
  text-transform: uppercase;
  letter-spacing: .05em;
}

.info .val {
  font-size: clamp(.95rem, 2.5vw, 1.12rem);
  font-weight: 900;
  margin-top: 4px;
  overflow-wrap: anywhere;
}

.calc-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr);
  gap: 18px;
}

.panel {
  border: 1px solid var(--line);
  border-radius: 22px;
  background: white;
  padding: clamp(14px, 2.4vw, 18px);
  min-width: 0;
}

h2 {
  margin: 0 0 14px;
  color: #17324a;
  font-size: clamp(1.25rem, 3vw, 1.5rem);
}

input, select {
  width: 100%;
  border: 1px solid #cbd5d1;
  border-radius: 14px;
  padding: 13px;
  font-size: 1rem;
  color: var(--text);
  background: white;
  min-height: 48px;
}

input:focus, select:focus {
  outline: none;
  border-color: var(--blue);
  box-shadow: 0 0 0 4px rgba(111,151,166,0.15);
}

.two {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-top: 8px;
}

.actions {
  display: grid;
  grid-template-columns: 1fr auto auto;
  gap: 10px;
  margin-top: 16px;
}

button.mainbtn, button.secbtn {
  border-radius: 14px;
  padding: 14px 16px;
  font-weight: 900;
  cursor: pointer;
  min-height: 48px;
  font-size: 1rem;
}

.mainbtn {
  border: none;
  color: white;
  background: linear-gradient(135deg, var(--green), var(--blue));
}

.secbtn {
  color: #27364a;
  background: #f1f6f4;
  border: 1px solid var(--line);
}

button:active {
  transform: scale(.99);
}

.result {
  display: none;
  margin-top: 16px;
  padding: 16px;
  border-radius: 18px;
  border: 1px solid #b9dac1;
  background: #f1fbf3;
  color: #073d20;
}

.result .big {
  font-size: clamp(1.65rem, 6vw, 2.4rem);
  font-weight: 950;
  margin-top: 4px;
  overflow-wrap: anywhere;
}

#error {
  display: none;
  margin-top: 16px;
  padding: 14px;
  border-radius: 16px;
  background: #fff1ef;
  border: 1px solid #f0b7af;
  color: #a3160a;
  font-weight: 800;
}

.note {
  color: var(--muted);
  line-height: 1.5;
  font-size: .95rem;
}

.table-wrap {
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

table {
  width: 100%;
  border-collapse: collapse;
  font-size: .9rem;
  min-width: 430px;
}

th, td {
  padding: 9px 7px;
  border-bottom: 1px solid var(--line);
  text-align: left;
}

th {
  color: var(--muted);
  font-size: .75rem;
  text-transform: uppercase;
}

.footer {
  text-align: center;
  color: var(--muted);
  font-size: .78rem;
  line-height: 1.4;
  padding: 0 22px 24px;
}

@media (max-width: 820px) {
  .calc-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 620px) {
  .wrapper {
    width: 100%;
    padding: 0;
  }

  body {
    background: var(--bg);
  }

  .app {
    border-radius: 0;
    border-left: 0;
    border-right: 0;
    min-height: 100vh;
    box-shadow: none;
  }

  .header {
    padding: 18px 14px 14px;
  }

  .logo {
    width: min(220px, 72vw);
    max-height: 175px;
  }

  .main {
    padding: 12px;
  }

  .formula-card, .panel {
    border-radius: 18px;
  }

  .quick-select {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .quick-select button {
    padding: 10px 6px;
    font-size: .88rem;
    min-width: 0;
  }

  .info-grid {
    grid-template-columns: 1fr;
  }

  .two {
    grid-template-columns: 1fr;
  }

  .actions {
    grid-template-columns: 1fr;
  }

  .secbtn, .mainbtn {
    width: 100%;
  }
}

@media (max-width: 380px) {
  .quick-select {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  #formula {
    font-size: 1.55rem;
  }

  h1 {
    font-size: 1.45rem;
  }
}

@media (hover: none) {
  .quick-select button:hover {
    background: #fff;
    color: #172033;
    border-color: #cfd8d3;
  }
}
</style>
</head>

<body>
<div class="wrapper">
  <div class="app">
    <header class="header">
      <img class="logo" src="data:image/png;base64," alt="NEGEV Lab logo">
      <h1>Concentration Unit Converter</h1>
      <p class="subtitle">mg/L, µg/L, M, mM, µM and nM conversions for common lab ions and free formulas.</p>
    </header>

    <main class="main">
      <section class="formula-card">
        <label for="formula" style="text-align:center;">Formula</label>
        <input id="formula" value="SO4" placeholder="e.g. SO4, PO4, NH4, Ca(NO3)2" oninput="refreshFormula()">

        <div class="quick-title">Quick Selection</div>
        <div class="quick-select">
          <button onclick="setFormula('SO4')">SO₄²⁻</button>
          <button onclick="setFormula('Cl')">Cl⁻</button>
          <button onclick="setFormula('Br')">Br⁻</button>
          <button onclick="setFormula('S')">S</button>
          <button onclick="setFormula('NO3')">NO₃⁻</button>
          <button onclick="setFormula('NH4')">NH₄⁺</button>
          <button onclick="setFormula('N')">N</button>
          <button onclick="setFormula('PO4')">PO₄³⁻</button>
          <button onclick="setFormula('P')">P</button>
          <button onclick="setFormula('Na')">Na⁺</button>
          <button onclick="setFormula('CH3COO')">Acetate</button>
          <button onclick="setFormula('CH3COONa')">Na-acetate</button>
          <button onclick="setFormula('NH4NO3')">NH₄NO₃</button>
          <button onclick="setFormula('CaCO3')">CaCO₃</button>
          <button onclick="setFormula('HCO3')">HCO₃⁻</button>
        </div>

        <div class="info-grid">
          <div class="info"><div class="key">Molar mass</div><div class="val" id="molarMass">—</div></div>
          <div class="info"><div class="key">Parsed as</div><div class="val" id="cleanFormula">—</div></div>
          <div class="info"><div class="key">Status</div><div class="val" id="formulaStatus">—</div></div>
        </div>
      </section>

      <section class="calc-grid">
        <div class="panel">
          <h2>Convert</h2>

          <label for="value">Value</label>
          <input id="value" type="number" inputmode="decimal" step="any" value="1000" oninput="convert()">

          <div class="two">
            <div>
              <label for="fromUnit">From</label>
              <select id="fromUnit" onchange="convert()">
                <option value="mgL" selected>mg/L</option>
                <option value="ugL">µg/L</option>
                <option value="gL">g/L</option>
                <option value="M">M</option>
                <option value="mM">mM</option>
                <option value="uM">µM</option>
                <option value="nM">nM</option>
              </select>
            </div>
            <div>
              <label for="toUnit">To</label>
              <select id="toUnit" onchange="convert()">
                <option value="mgL">mg/L</option>
                <option value="ugL">µg/L</option>
                <option value="gL">g/L</option>
                <option value="M">M</option>
                <option value="mM" selected>mM</option>
                <option value="uM">µM</option>
                <option value="nM">nM</option>
              </select>
            </div>
          </div>

          <div class="actions">
            <button class="mainbtn" onclick="convert()">Convert</button>
            <button class="secbtn" onclick="swapUnits()">Swap</button>
            <button class="secbtn" onclick="copyResult()">Copy</button>
          </div>

          <div id="result" class="result">
            <div>Result</div>
            <div class="big" id="resultBig"></div>
            <div id="resultSmall"></div>
          </div>
          <div id="error"></div>
        </div>

        <div class="panel">
          <h2>Important note</h2>
          <p class="note">
            Use <b>P</b> when a concentration is reported as phosphorus. Use <b>PO4</b> when it is reported as phosphate.
            Use <b>N</b> when a concentration is reported as nitrogen. Use <b>NO3</b> or <b>NH4</b> when it is reported as nitrate or ammonium.
          </p>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Formula</th><th>Molar mass</th><th>Name</th></tr></thead>
              <tbody>
                <tr><td>SO4</td><td>96.06</td><td>Sulfate</td></tr>
                <tr><td>Cl</td><td>35.45</td><td>Chloride</td></tr>
                <tr><td>NO3</td><td>62.00</td><td>Nitrate</td></tr>
                <tr><td>NH4</td><td>18.04</td><td>Ammonium</td></tr>
                <tr><td>PO4</td><td>94.97</td><td>Phosphate</td></tr>
                <tr><td>CH3COO</td><td>59.04</td><td>Acetate</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      NEGEV Lab | Natural and Experimental Geochemistry of the Environment
    </footer>
  </div>
</div>

<script>
const atomicMass = {
  H:1.00794, He:4.002602, Li:6.941, Be:9.012182, B:10.811, C:12.0107, N:14.0067,
  O:15.9994, F:18.9984032, Ne:20.1797, Na:22.98976928, Mg:24.3050, Al:26.9815386,
  Si:28.0855, P:30.973762, S:32.065, Cl:35.453, Ar:39.948, K:39.0983, Ca:40.078,
  Fe:55.845, Cu:63.546, Zn:65.38, Br:79.904, I:126.90447, Ba:137.327, Pb:207.2
};

let lastResultText = "";

function cleanInputFormula(raw) {
  return raw.replace(/\s+/g,"")
    .replace(/[₀₁₂₃₄₅₆₇₈₉]/g, d => "₀₁₂₃₄₅₆₇₈₉".indexOf(d))
    .replace(/²/g,"2").replace(/³/g,"3").replace(/⁺/g,"+").replace(/⁻/g,"-")
    .replace(/\^?\d*[+-]$/g,"").replace(/[+-]$/g,"");
}

function parseFormula(formula) {
  formula = cleanInputFormula(formula);
  if(!formula) throw new Error("Enter formula");
  let i = 0;

  function parseNumber() {
    let s = "";
    while(i < formula.length && /[0-9.]/.test(formula[i])) s += formula[i++];
    if(!s) return 1;
    const n = parseFloat(s);
    if(!isFinite(n) || n <= 0) throw new Error("Bad number");
    return n;
  }

  function parseGroup() {
    let comp = {};
    while(i < formula.length) {
      if(formula[i] === "(") {
        i++;
        const inner = parseGroup();
        if(formula[i] !== ")") throw new Error("Missing )");
        i++;
        const mult = parseNumber();
        for(const el in inner) comp[el] = (comp[el] || 0) + inner[el] * mult;
      } else if(formula[i] === ")") {
        break;
      } else if(/[A-Z]/.test(formula[i])) {
        let el = formula[i++];
        if(i < formula.length && /[a-z]/.test(formula[i])) el += formula[i++];
        if(!(el in atomicMass)) throw new Error("Unknown element: " + el);
        const count = parseNumber();
        comp[el] = (comp[el] || 0) + count;
      } else {
        throw new Error("Unexpected: " + formula[i]);
      }
    }
    return comp;
  }

  const comp = parseGroup();
  if(i !== formula.length) throw new Error("Formula parse error");
  let mass = 0;
  for(const el in comp) mass += atomicMass[el] * comp[el];
  return {clean: formula, mass};
}

function fmt(x) {
  if(!isFinite(x)) return "";
  const ax = Math.abs(x);
  if(ax === 0) return "0";
  if(ax >= 100000 || ax < 0.001) return x.toExponential(4);
  if(ax >= 100) return x.toFixed(2).replace(/\.00$/,"");
  if(ax >= 10) return x.toFixed(3).replace(/0+$/,"").replace(/\.$/,"");
  return x.toFixed(5).replace(/0+$/,"").replace(/\.$/,"");
}

function unitLabel(u) {
  return {mgL:"mg/L", ugL:"µg/L", gL:"g/L", M:"M", mM:"mM", uM:"µM", nM:"nM"}[u];
}

function toMolL(v,u,mw) {
  if(u==="M") return v;
  if(u==="mM") return v/1000;
  if(u==="uM") return v/1e6;
  if(u==="nM") return v/1e9;
  if(u==="gL") return v/mw;
  if(u==="mgL") return v/1000/mw;
  if(u==="ugL") return v/1e6/mw;
}

function fromMolL(v,u,mw) {
  if(u==="M") return v;
  if(u==="mM") return v*1000;
  if(u==="uM") return v*1e6;
  if(u==="nM") return v*1e9;
  if(u==="gL") return v*mw;
  if(u==="mgL") return v*mw*1000;
  if(u==="ugL") return v*mw*1e6;
}

function refreshFormula() {
  try {
    const p = parseFormula(document.getElementById("formula").value);
    document.getElementById("molarMass").textContent = fmt(p.mass) + " g/mol";
    document.getElementById("cleanFormula").textContent = p.clean;
    document.getElementById("formulaStatus").textContent = "OK";
    document.getElementById("formulaStatus").style.color = "#087443";
    convert(false);
    return p;
  } catch(e) {
    document.getElementById("molarMass").textContent = "—";
    document.getElementById("cleanFormula").textContent = "—";
    document.getElementById("formulaStatus").textContent = e.message;
    document.getElementById("formulaStatus").style.color = "#a3160a";
    return null;
  }
}

function setFormula(x) {
  document.getElementById("formula").value = x;
  refreshFormula();
}

function showError(msg) {
  document.getElementById("result").style.display = "none";
  const e = document.getElementById("error");
  e.textContent = msg;
  e.style.display = "block";
}

function convert(show=true) {
  const errorBox = document.getElementById("error");
  errorBox.style.display = "none";
  const p = parseFormula(document.getElementById("formula").value);
  const val = parseFloat(document.getElementById("value").value);
  if(!isFinite(val)) {
    if(show) showError("Enter a valid value.");
    return;
  }

  const from = document.getElementById("fromUnit").value;
  const to = document.getElementById("toUnit").value;
  const molL = toMolL(val, from, p.mass);
  const out = fromMolL(molL, to, p.mass);
  const resultText = fmt(out) + " " + unitLabel(to);
  const small = fmt(val) + " " + unitLabel(from) + " as " + p.clean + " = " + resultText;

  document.getElementById("resultBig").textContent = resultText;
  document.getElementById("resultSmall").textContent = small;
  document.getElementById("result").style.display = "block";
  lastResultText = small + " | Molar mass: " + fmt(p.mass) + " g/mol";
}

function swapUnits() {
  const f = document.getElementById("fromUnit");
  const t = document.getElementById("toUnit");
  const tmp = f.value;
  f.value = t.value;
  t.value = tmp;
  convert();
}

async function copyResult() {
  if(!lastResultText) convert();
  try {
    await navigator.clipboard.writeText(lastResultText);
    const buttons = document.querySelectorAll(".secbtn");
    const copyButton = buttons[1];
    const old = copyButton.textContent;
    copyButton.textContent = "Copied";
    setTimeout(() => copyButton.textContent = old, 900);
  } catch(e) {
    showError("Copy failed.");
  }
}

refreshFormula();
convert();
</script>
</body>
</html>
